# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Authorized Telegram numeric User IDs (comma-separated).
# Obtain your ID from @userinfobot on Telegram.
# Only requests from these user IDs will be processed.
ALLOWED_TELEGRAM_USER_IDS=123456789

# Database path (SQLite)
DB_PATH=data/security_bot.db

# Storage path for raw scan dumps
RAW_OUTPUT_DIR=data/scans

# OWASP ZAP REST API settings (optional, if ZAP daemon is running)
ZAP_BASE_URL=http://localhost:8080
ZAP_API_KEY=

# Scanner binary paths (leave empty if available in system PATH)
NUCLEI_BIN=
NIKTO_BIN=
GITLEAKS_BIN=
SSLYZE_BIN=

# HaveIBeenPwned API Key (optional, for breach lookup)
HIBP_API_KEY=

# Maximum concurrent background scans allowed
MAX_CONCURRENT_SCANS=2
